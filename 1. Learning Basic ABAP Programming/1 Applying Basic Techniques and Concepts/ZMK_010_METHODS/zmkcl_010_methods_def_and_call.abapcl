* LOCAL TYPES
* this goes in Local Types tab
*************************************************************
*"* use this source file for the definition and implementation of
*"* local helper classes, interface definitions and type
*"* declarations
*CLASS lcl_connection DEFINITION CREATE PRIVATE.
*
*  PUBLIC SECTION.
*  PROTECTED SECTION.
*  PRIVATE SECTION.
*
*ENDCLASS.
*
*CLASS lcl_connection IMPLEMENTATION.
*
*ENDCLASS.

CLASS lcl_connection DEFINITION.

  PUBLIC SECTION.

    DATA carrier_id TYPE s_carr_id.
    DATA connection_id TYPE s_conn_id.

    CLASS-DATA conn_counter TYPE i.

    METHODS set_attributes
      IMPORTING
        iv_connection_id TYPE s_conn_id OPTIONAL
        iv_carrier_id    TYPE s_carr_id OPTIONAL.

    METHODS get_attributes
      ExPORTING
        ev_connection_id TYPE s_conn_id
        ev_carrier_id    TYPE s_carr_id .

  PROTECTED SECTION.
  PRIVATE SECTION.

ENDCLASS.

CLASS lcl_connection IMPLEMENTATION.

  METHOD set_attributes.
    me->carrier_id = iv_carrier_id.
    me->connection_id = iv_connection_id.
  ENDMETHOD.

  METHOD get_attributes.
    ev_carrier_id = carrier_id.
    ev_connection_id = connection_id.
  ENDMETHOD.

ENDCLASS.

*************************************************************
* END OF LOCAL TYPES
* this goes in Local Types tab
*************************************************************

***************************************************************
* GLOBAL CLASS
* this goes in the Global Class tab
***************************************************************

CLASS zmkcl_010_methods_def_and_call DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    INTERFACES if_oo_adt_classrun .
    METHODS:
      main_report.

  PROTECTED SECTION.
  PRIVATE SECTION.
    CLASS-DATA mt_output TYPE TABLE OF string.
    METHODS  generate_output.

ENDCLASS.



CLASS zmkcl_010_methods_def_and_call IMPLEMENTATION.
  METHOD if_oo_adt_classrun~main.
    generate_output(  ).
    LOOP AT mt_output INTO DATA(row).
      out->write( row ).
    ENDLOOP.
  ENDMETHOD.

  METHOD main_report.
    generate_output(  ).
    LOOP AT mt_output INTO DATA(row).
      WRITE / row.
    ENDLOOP.
  ENDMETHOD.

  METHOD generate_output.
    DATA connection TYPE REF TO lcl_connection.
    connection = NEW #( ).

    connection->carrier_id = 'LH'.
    connection->connection_id = '0400'.
    lcl_connection=>conn_counter = '1234'.

    APPEND connection->carrier_id TO mt_output.
    APPEND connection->connection_id TO mt_output.
    APPEND lcl_connection=>conn_counter TO mt_output.

    APPEND |calling method SET_ATTRIBUTES( iv_carrier_id = 'id1' iv_connection_id = '123' )| TO mt_output.
    connection->set_attributes( iv_carrier_id = 'AZ' iv_connection_id = '0555' ).

    APPEND |calling method GET_ATTRIBUTES:| TO mt_output.
    APPEND |carrier id: { connection->carrier_id } | TO mt_output.
    APPEND |connection id: { connection->connection_id } | TO mt_output.


  ENDMETHOD.
ENDCLASS.


